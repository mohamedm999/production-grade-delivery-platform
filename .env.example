# ==============================================================================
# SWIFTDISPATCH ENVIRONMENT CONFIGURATION
# Replace placeholders with your real Supabase project credentials.
# Get these from: Supabase Project Settings > API
# ==============================================================================

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
